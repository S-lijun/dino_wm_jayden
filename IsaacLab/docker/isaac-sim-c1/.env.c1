# Edit these before building/running on Compute1.

# Your Docker Hub username (RIS docker_build pushes here).
DOCKERHUB_USER=jaydenli1015

# Image name/tag pushed by docker_build and used by bsub.
IMAGE_NAME=isaac-sim-c1
IMAGE_TAG=5.1.0

# LSF group / queue
LSF_GROUP=compute-sibai
LSF_QUEUE=general-interactive

# Storage1 project root (host path)
STORAGE_ROOT=/storage1/fs1/sibai/Active/ihab/research_new

# C1-only venv path (create with setup_venv_c1.sh inside the container)
VENV_NAME=isaaclab5_pip_c1
